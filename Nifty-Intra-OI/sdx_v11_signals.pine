//@version=6
// SD-X v11  Nifty Intraday Signals (option-buyer oriented)
//  Only 4 request.security() calls — no dynamic option symbols, so it never hits
//  the 40-request cap. Load "SD-X v11 OI" alongside for the live option chain.
indicator("SD-X v11  Nifty Intraday Signals", "SD-X v11", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═══════════════════ Inputs ═══════════════════
grpS       = "Intraday session"
mktSess    = input.session("0915-1530", "Market session (IST)", group = grpS)
entrySess  = input.session("0920-1500", "Entry window", group = grpS)
expEntry   = input.session("0920-1300", "Entry window on EXPIRY day", group = grpS)
sqOffTime  = input.session("1515-1530", "Square-off window", group = grpS)
maxPerDay  = input.int(3, "Max trades per day", minval = 1, group = grpS)
clearDaily = input.bool(true, "Clear cross-index levels each morning", group = grpS)

grpOpt     = "Option sizing (display only)"
strikeStep = input.int(50, "Strike interval", minval = 1, group = grpOpt)
lotSize    = input.int(65, "Lot size", minval = 1, group = grpOpt)
lots       = input.int(1, "Lots per trade", minval = 1, group = grpOpt)
deltaATM   = input.float(0.5, "ATM delta (premium estimate)", minval = 0.2, maxval = 0.9, step = 0.05, group = grpOpt)
expDow     = input.int(3, "Weekly expiry weekday (1=Sun … 7=Sat; Tue=3)", minval = 1, maxval = 7, group = grpOpt)

grpZ       = "Supply / Demand zones"
zoneMode   = input.string("Auto (near price)", "Zone source",
     options = ["Auto (near price)", "Daily gap-adaptive", "Previous candle", "Last pivot", "Range extremes"], group = grpZ)
gapPct     = input.float(0.25, "Gap threshold (prev day range x)", minval = 0.05, step = 0.05, group = grpZ)
showTgt    = input.bool(true, "Show target tiers (gap-adaptive mode)", group = grpZ)
autoN      = input.int(40, "Auto lookback (chart bars)", minval = 10, group = grpZ)
zoneTF     = input.timeframe("60", "Zone timeframe (other modes)", group = grpZ)
zoneLen    = input.int(2,  "Pivot strength (Last pivot mode)", minval = 1, group = grpZ)
rangeN     = input.int(10, "Bars (Range extremes mode)", minval = 2, group = grpZ)
rejMode    = input.string("Loose", "Zone rejection", options = ["Strict", "Loose"], group = grpZ)
minZone    = input.float(15, "Min zone height (points)", minval = 0, group = grpZ)
maxZoneATR = input.float(4.0, "Warn if zone is further than (ATR ×)", minval = 1, group = grpZ)
keepZones  = input.int(20, "Zone sets to keep on history", minval = 1, maxval = 200, group = grpZ)
extendBars = input.int(60, "Extend live zone to the right (bars)", minval = 10, group = grpZ)
supCol     = input.color(color.new(#ff8a65, 60), "Supply zone", group = grpZ)
demCol     = input.color(color.new(#4db6ac, 60), "Demand zone", group = grpZ)

grpX       = "Cross-index levels"
showLvls   = input.bool(true, "Show cross-index levels", group = grpX)
symA       = input.symbol("NSE:BANKNIFTY", "Reference index", group = grpX)
lblA       = input.string("BN", "Level tag", group = grpX)
pivLen     = input.int(8,  "Pivot length (chart TF)", minval = 1, group = grpX)
maxLv      = input.int(4,  "Max levels kept", minval = 1, group = grpX)
removeHit  = input.bool(true, "Remove level once price closes through it", group = grpX)
extendMode = input.string("To current bar", "Line extension", options = ["Fixed length", "To current bar"], group = grpX)
lineLen    = input.int(60, "Fixed length (bars)", minval = 5, group = grpX)
colA       = input.color(color.new(color.red,  20), "Level colour", group = grpX)

grpF       = "Confirmation filters"
vwapMode   = input.string("Stretch", "VWAP mode", options = ["Trend", "Stretch", "Off"], group = grpF)
stretchX   = input.float(1.5, "Stretch distance from VWAP (ATR ×)", minval = 0.5, step = 0.1, group = grpF)
useEMA     = input.bool(false, "EMA trend filter", group = grpF)
emaLen     = input.int(21, "EMA length", minval = 2, group = grpF)
useRSI     = input.bool(true,  "RSI filter", group = grpF)
rsiLen     = input.int(14, "RSI length", minval = 2, group = grpF)
useLevels  = input.bool(true,  "Also trigger on cross-index level bounces", group = grpF)
cooldown   = input.int(6, "Min bars between signals", minval = 0, group = grpF)
showVWAP   = input.bool(true,  "Plot VWAP", group = grpF)
showEMA    = input.bool(false, "Plot EMA", group = grpF)

grpT       = "Risk (index points)"
slBuf      = input.float(0.5, "SL buffer beyond zone/level (ATR ×)", minval = 0, step = 0.1, group = grpT)
minRisk    = input.float(20, "Min stop distance", minval = 1, group = grpT)
maxRisk    = input.float(70, "Max stop distance", minval = 5, group = grpT)
rr         = input.float(2.0, "Risk : Reward", minval = 0.5, step = 0.25, group = grpT)
tpMode     = input.string("Fixed R:R", "Target mode",
     options = ["Fixed R:R", "Structure (gap tiers)", "Opening-range ladder"], group = grpT)
minRR      = input.float(1.0, "Min R:R to the structural target", minval = 0.25, step = 0.25, group = grpT)

grpD       = "Diagnostics"
showNM     = input.bool(true, "Mark blocked setups (grey ✕)", group = grpD)
showDiag   = input.bool(true, "Show diagnostic table", group = grpD)
showStats  = input.bool(true, "Show today's stats table", group = grpD)

grpG       = "GTI engine (ported)"
useVol     = input.string("Auto", "Volume confirmation", options = ["Auto", "On", "Off"], group = grpG)
volMult    = input.float(1.35, "Whale volume multiplier", minval = 1.0, step = 0.05, group = grpG)
extVolMult = input.float(2.0,  "Climax volume multiplier", minval = 1.0, step = 0.1, group = grpG)
atrExpMult = input.float(1.4,  "Range expansion (ATR x)", minval = 1.0, step = 0.1, group = grpG)
swingLen   = input.int(15, "Base / ceiling lookback", minval = 2, group = grpG)
isoBars    = input.int(30, "Flag isolation window", minval = 5, group = grpG)
showSqz    = input.bool(true, "Shade compression", group = grpG)
showBars   = input.bool(true, "Colour whale / absorption bars", group = grpG)
showCandle = input.bool(true, "Mark injection / belan candles", group = grpG)
showFlags  = input.bool(true, "Mark shark / whale flags", group = grpG)
showShelf  = input.bool(true, "Draw climax shelves", group = grpG)
maxShelf   = input.int(8,  "Max shelves kept", minval = 2, group = grpG)
shelfBars  = input.int(35, "Shelf length (bars)", minval = 5, group = grpG)
showPhase  = input.bool(true, "Show CAMDC phase row", group = grpG)

grpW       = "Wave (5) exhaustion"
useWave5   = input.bool(true, "Veto entries after exhaustion", group = grpW)
w5Look     = input.int(14, "Wave peak lookback", minval = 3, group = grpW)
lockBars   = input.int(8,  "Lockout bars", minval = 1, group = grpW)

grpE       = "Entry sources"
useZone    = input.bool(true,  "Zone rejection", group = grpE)
use4Flag   = input.bool(true,  "Whale 4-flag expansion", group = grpE)
useAbsorb  = input.bool(true,  "Absorption at base / ceiling", group = grpE)
blockSqz   = input.bool(false, "Block entries while compressed", group = grpE)
useExpand  = input.bool(true,  "Expansion bar (squeeze release, with bias)", group = grpE)
expandRR   = input.float(1.5, "Expansion bar R:R (always fixed)", minval = 0.5, step = 0.25, group = grpE)

grpV       = "Volatility regime"
showVix    = input.bool(true, "Show India VIX regime row", group = grpV)
vixSym     = input.symbol("NSE:INDIAVIX", "VIX symbol", group = grpV)
vixLow     = input.float(13, "Low / moderate VIX boundary", minval = 5, step = 0.5, group = grpV)
vixHigh    = input.float(18, "Moderate / high VIX boundary", minval = 6, step = 0.5, group = grpV)

grpO       = "GTI opening range & day bias"
useORB     = input.bool(true,  "Track the opening candle", group = grpO)
orbMin     = input.int(9, "Opening candle length (minutes)", minval = 1, group = grpO)
fakeTol    = input.float(0.0, "Fake-candle tolerance (points)", minval = 0, step = 0.25, group = grpO)
biasVeto   = input.bool(false, "Trade only in the opening-break direction", group = grpO)
ladderN    = input.int(3, "Ladder rungs (1:1 … 1:N)", minval = 1, maxval = 3, group = grpO)
ladderStop = input.bool(false, "Veto further entries once 1:N is reached", group = grpO)
showORB    = input.bool(true,  "Draw opening range and ladder", group = grpO)

grpC       = "GTI structural compression"
compressX  = input.float(0.75, "Compressed when battlefield < (ATR ×)", minval = 0.1, step = 0.05, group = grpC)
reqCompress = input.bool(false, "Only take entries on compressed days", group = grpC)

grpA       = "GTI zone-attack counter"
useAttack  = input.bool(true, "Attack-count entries", group = grpA)
attackMin  = input.int(3, "Attacks before the zone is tradeable", minval = 2, maxval = 6, group = grpA)
showAttack = input.bool(true, "Number the attack candles", group = grpA)

// ═══════════════════ Core series ═══════════════════
float atr   = ta.atr(14)
float vwapV = ta.vwap(hlc3)
float emaV  = ta.ema(close, emaLen)
float rsiV  = ta.rsi(close, rsiLen)

bool inMkt   = not na(time(timeframe.period, mktSess,   "Asia/Kolkata"))
bool inEntry = not na(time(timeframe.period, entrySess, "Asia/Kolkata"))
bool inExpE  = not na(time(timeframe.period, expEntry,  "Asia/Kolkata"))
bool inSqOff = not na(time(timeframe.period, sqOffTime, "Asia/Kolkata"))
bool newDay  = ta.change(time("D")) != 0
bool forceExit = inSqOff or (inMkt[1] and not inMkt) or newDay
bool isExpiry  = dayofweek(time, "Asia/Kolkata") == expDow
int  atmStrike = int(math.round(close / strikeStep) * strikeStep)

// ═══════════════════ Opening range & day bias (GTI) ═══════════════════
// The first candle of the day is a fake when it opens on its own high or its own
// low: no two-way auction happened inside it, so its range is not a fight anyone
// won. In that case the second candle is the reference instead. Whichever side of
// the reference candle breaks first owns the rest of the session - that is the
// only direction worth trading, and the ladder measures the day off its height.
var int   dayOpenT = na
var float o1o = na
var float o1h = na
var float o1l = na
var float o2o = na
var float o2h = na
var float o2l = na
var int   dayBias = 0
var float orbHi = na
var float orbLo = na
var bool  orbFake = false

if newDay
    dayOpenT := na
    o1o := na
    o1h := na
    o1l := na
    o2o := na
    o2h := na
    o2l := na
    dayBias := 0
    orbHi := na
    orbLo := na
    orbFake := false

if inMkt and useORB
    if na(dayOpenT)
        dayOpenT := time
    int mins = int((time - dayOpenT) / 60000)
    if mins < orbMin
        o1o := na(o1o) ? open : o1o
        o1h := na(o1h) ? high : math.max(o1h, high)
        o1l := na(o1l) ? low  : math.min(o1l, low)
    else if mins < orbMin * 2
        o2o := na(o2o) ? open : o2o
        o2h := na(o2h) ? high : math.max(o2h, high)
        o2l := na(o2l) ? low  : math.min(o2l, low)

// A candle is only settled once the window after it has opened, so the reference
// range never repaints inside its own bars.
int  minsIn = na(dayOpenT) ? int(na) : int((time - dayOpenT) / 60000)
bool c1Done = not na(o1h) and not na(minsIn) and minsIn >= orbMin
bool c2Done = not na(o2h) and not na(minsIn) and minsIn >= orbMin * 2
if c1Done and na(orbHi)
    orbFake := (o1h - o1o <= fakeTol) or (o1o - o1l <= fakeTol)
    if not orbFake
        orbHi := o1h
        orbLo := o1l
if orbFake and c2Done and na(orbHi)
    orbHi := o2h
    orbLo := o2l

bool  orbReady = not na(orbHi) and not na(orbLo)
float orbRange = orbReady ? math.max(orbHi - orbLo, syminfo.mintick) : na
// First close through either edge sets the bias, and it is latched: a day that
// breaks up then breaks down is a day GTI does not trade the second break of.
if orbReady and inMkt and dayBias == 0
    dayBias := close > orbHi ? 1 : close < orbLo ? -1 : 0

var bool ladderHitU = false
var bool ladderHitD = false
if newDay
    ladderHitU := false
    ladderHitD := false
if orbReady and high >= orbHi + orbRange * ladderN
    ladderHitU := true
if orbReady and low  <= orbLo - orbRange * ladderN
    ladderHitD := true

// Ladder rungs are multiples of the opening candle's own height projected from
// its edges - 1:1, 1:2, 1:3 - not multiples of the stop.
f_rungUp(float px) =>
    float r = na
    for k = 0 to ladderN
        float lv = orbHi + orbRange * k
        if lv > px and na(r)
            r := lv
    r
f_rungDn(float px) =>
    float r = na
    for k = 0 to ladderN
        float lv = orbLo - orbRange * k
        if lv < px and na(r)
            r := lv
    r

bool orbDraw = showORB and orbReady
plot(orbDraw ? orbHi : na, "ORB high", color = color.new(color.blue, 0), style = plot.style_linebr, linewidth = 2)
plot(orbDraw ? orbLo : na, "ORB low",  color = color.new(color.blue, 0), style = plot.style_linebr, linewidth = 2)
plot(orbDraw and ladderN >= 1 ? orbHi + orbRange     : na, "1:1 up", color = color.new(color.blue, 45), style = plot.style_linebr)
plot(orbDraw and ladderN >= 2 ? orbHi + orbRange * 2 : na, "1:2 up", color = color.new(color.blue, 60), style = plot.style_linebr)
plot(orbDraw and ladderN >= 3 ? orbHi + orbRange * 3 : na, "1:3 up", color = color.new(color.blue, 75), style = plot.style_linebr)
plot(orbDraw and ladderN >= 1 ? orbLo - orbRange     : na, "1:1 dn", color = color.new(color.blue, 45), style = plot.style_linebr)
plot(orbDraw and ladderN >= 2 ? orbLo - orbRange * 2 : na, "1:2 dn", color = color.new(color.blue, 60), style = plot.style_linebr)
plot(orbDraw and ladderN >= 3 ? orbLo - orbRange * 3 : na, "1:3 dn", color = color.new(color.blue, 75), style = plot.style_linebr)

// India VIX regime (request #5). ignore_invalid_symbol keeps a bad ticker from
// killing the whole script - it returns na and the row reads "n/a" instead.
float  vix       = request.security(vixSym, "D", close, ignore_invalid_symbol = true)
string regime    = na(vix) ? "n/a" : vix < vixLow ? "Low - rangebound"
     : vix <= vixHigh ? "Moderate - trending" : "High - vega crush"
string strikeAdv = na(vix) ? "ATM" : vix < vixLow ? "ATM / slight OTM"
     : vix <= vixHigh ? "ATM / slight ITM" : "ITM (vega shield)"
color  vixCol    = na(vix) ? color.gray : vix < vixLow ? color.green
     : vix <= vixHigh ? color.orange : color.red

// ═══════════════════ Daily gap-adaptive zones  (request #1) ═══════════════════
// Prior-day structure, tiered by this morning's gap. One tuple call, not six.
// lookahead_on is safe here: every leg is either [1]-offset (a closed daily bar)
// or the daily open, which is already known when the 09:15 bar opens.
[dHi1, dLo1, dCl1, dOp0, dLoN, dHiN] = request.security(syminfo.tickerid, "D",
     [high[1], low[1], close[1], open, ta.lowest(low, 4)[1], ta.highest(high, 4)[1]],
     lookahead = barmerge.lookahead_on)

var float supTgtTop  = na
var float supTgtBot  = na
var float supMainTop = na
var float supMainBot = na
var float demMainTop = na
var float demMainBot = na
var float demTgtTop  = na
var float demTgtBot  = na

if newDay and not na(dHi1) and not na(dOp0)
    float gap    = dOp0 - dCl1
    float pRange = math.max(dHi1 - dLo1, strikeStep * 2.0)
    float gThr   = pRange * gapPct
    if gap < -gThr                                    // gap down: yesterday's close is the cap
        supMainTop := dCl1
        supMainBot := dCl1 - math.abs(gap) * 0.35
        supTgtTop  := dHi1
        supTgtBot  := dHi1 - pRange * 0.15
        demMainTop := dOp0
        demMainBot := math.min(dOp0 - pRange * 0.20, dLoN)
        demTgtTop  := demMainBot
        demTgtBot  := demMainBot - pRange * 0.30
    else if gap > gThr                                // gap up: yesterday's close is the floor
        supTgtTop  := math.max(dHiN, dOp0 + pRange * 0.30)
        supTgtBot  := supTgtTop - pRange * 0.15
        supMainTop := dOp0 + pRange * 0.20
        supMainBot := dOp0
        demMainTop := dCl1 + gap * 0.35
        demMainBot := dCl1
        demTgtTop  := dLo1 + pRange * 0.15
        demTgtBot  := dLo1
    else                                              // flat open: plain prior-day structure
        supTgtTop  := dHiN
        supTgtBot  := dHiN - pRange * 0.15
        supMainTop := dHi1
        supMainBot := math.max(dCl1, dHi1 - pRange * 0.25)
        demMainTop := math.min(dCl1, dLo1 + pRange * 0.25)
        demMainBot := dLo1
        demTgtTop  := dLoN
        demTgtBot  := dLoN - pRange * 0.20

// ═══════════════════ Zones  (request #2) ═══════════════════
f_zones() =>
    float sTop = na
    float sBot = na
    float dTop = na
    float dBot = na
    if zoneMode == "Previous candle"
        sTop := high[1]
        sBot := math.max(open[1], close[1])
        dTop := math.min(open[1], close[1])
        dBot := low[1]
    else if zoneMode == "Last pivot"
        bool isPH = not na(ta.pivothigh(high, zoneLen, zoneLen))
        bool isPL = not na(ta.pivotlow(low,  zoneLen, zoneLen))
        sTop := ta.valuewhen(isPH, high[zoneLen], 0)
        sBot := ta.valuewhen(isPH, math.max(open, close)[zoneLen], 0)
        dTop := ta.valuewhen(isPL, math.min(open, close)[zoneLen], 0)
        dBot := ta.valuewhen(isPL, low[zoneLen], 0)
    else
        float hh = ta.highest(high, rangeN)[1]
        float ll = ta.lowest(low,  rangeN)[1]
        sTop := hh
        sBot := ta.valuewhen(high[1] == hh, math.max(open[1], close[1]), 0)
        dTop := ta.valuewhen(low[1]  == ll, math.min(open[1], close[1]), 0)
        dBot := ll
    [sTop, sBot, dTop, dBot]

[htfSupTop, htfSupBot, htfDemTop, htfDemBot] = request.security(syminfo.tickerid, zoneTF, f_zones(),
     lookahead = barmerge.lookahead_off)

bool autoMode = zoneMode == "Auto (near price)"
bool gapMode  = zoneMode == "Daily gap-adaptive"
float thick = math.max(minZone, atr)
// [1]: the auto zone is what price did BEFORE this bar. With the live bar
// included, a breakout bar's own high was the supply, so no bar could ever
// close above it and every long at a new high died at the room stage -
// 11-Sep-2026 11:12, a 45-point expansion bar the pipeline could not take.
float supTop = autoMode ? ta.highest(high, autoN)[1]
     : gapMode ? supMainTop : htfSupTop
float supBot = autoMode ? ta.highest(high, autoN)[1] - thick
     : gapMode ? math.min(supMainBot, supMainTop - minZone) : math.min(htfSupBot, htfSupTop - minZone)
float demBot = autoMode ? ta.lowest(low, autoN)[1]
     : gapMode ? demMainBot : htfDemBot
float demTop = autoMode ? ta.lowest(low, autoN)[1] + thick
     : gapMode ? math.max(demMainTop, demMainBot + minZone) : math.max(htfDemTop, htfDemBot + minZone)

var array<box> zBoxes = array.new<box>()
var box curSup = na
var box curDem = na
var float pSupTop = na
var float pDemBot = na

f_trimBoxes() =>
    while array.size(zBoxes) > keepZones * 2
        box.delete(array.shift(zBoxes))

bool zoneReady   = not na(supTop) and not na(supBot) and not na(demTop) and not na(demBot)

// ═══════════════════ Structural compression (GTI) ═══════════════════
// Not the Bollinger-inside-Keltner squeeze further down - that is a volatility
// read on one bar. This is the battlefield: the clear air between the demand
// zone's ceiling and the supply zone's floor. When the two sides' areas close on
// each other nobody on the tape can tell buyer from seller, and the move that
// follows has to be big enough to separate them again. Latched at the open, so
// it describes the day rather than the bar.
var float battle = na
var bool  structCompressed = false
if newDay and zoneReady
    battle := supBot - demTop
    structCompressed := battle < atr * compressX
bool zoneChanged = zoneReady and (supTop != pSupTop or demBot != pDemBot)
bool needNewBox  = zoneReady and (na(curSup) or newDay or (not autoMode and zoneChanged))

if needNewBox
    curSup := box.new(bar_index, supTop, bar_index + 1, supBot, border_color = na, bgcolor = supCol)
    curDem := box.new(bar_index, demTop, bar_index + 1, demBot, border_color = na, bgcolor = demCol)
    array.push(zBoxes, curSup)
    array.push(zBoxes, curDem)
    f_trimBoxes()

if zoneChanged
    pSupTop := supTop
    pDemBot := demBot

if not na(curSup) and zoneReady
    box.set_top(curSup, supTop)
    box.set_bottom(curSup, supBot)
    box.set_top(curDem, demTop)
    box.set_bottom(curDem, demBot)
    int rx = barstate.islast ? bar_index + extendBars : bar_index + 1
    box.set_right(curSup, rx)
    box.set_right(curDem, rx)
    if barstate.islast
        box.set_text(curSup, "Supply")
        box.set_text(curDem, "Demand")
        box.set_text_size(curSup, size.small)
        box.set_text_size(curDem, size.small)
        box.set_text_color(curSup, color.gray)
        box.set_text_color(curDem, color.gray)
        box.set_text_halign(curSup, text.align_right)
        box.set_text_halign(curDem, text.align_right)
        box.set_text_valign(curSup, text.align_bottom)
        box.set_text_valign(curDem, text.align_top)

// Target tiers - where the move is trying to reach, not where it turns.
pStT = plot(gapMode and showTgt ? supTgtTop : na, "Supply target top", color = color.new(color.teal, 60), style = plot.style_linebr)
pStB = plot(gapMode and showTgt ? supTgtBot : na, "Supply target bot", color = color.new(color.teal, 60), style = plot.style_linebr)
fill(pStT, pStB, color = color.new(color.teal, 88), title = "Supply target")
pDtT = plot(gapMode and showTgt ? demTgtTop : na, "Demand target top", color = color.new(color.teal, 60), style = plot.style_linebr)
pDtB = plot(gapMode and showTgt ? demTgtBot : na, "Demand target bot", color = color.new(color.teal, 60), style = plot.style_linebr)
fill(pDtT, pDtB, color = color.new(color.teal, 88), title = "Demand target")

// ═══════════════════ Cross-index levels  (request #3) ═══════════════════
// One reference index only. Sensex was dropped: ~0.99 correlated with Nifty and
// near-identical constituents, so its pivots land on Nifty's own - clutter, not
// information. BankNifty earns the slot because it can diverge.
type Lvl
    line  ln
    label lb
    float y
    bool  isHigh

f_pivots(string sym) =>
    request.security(sym, timeframe.period,
         [ta.pivothigh(high, pivLen, pivLen), ta.pivotlow(low, pivLen, pivLen)],
         lookahead = barmerge.lookahead_off)

[aPH, aPL] = f_pivots(symA)

var array<Lvl> lvlA = array.new<Lvl>()

f_trim(array<Lvl> arr, int keep) =>
    while array.size(arr) > keep
        Lvl v = array.shift(arr)
        line.delete(v.ln)
        label.delete(v.lb)

f_clearAll(array<Lvl> arr) =>
    while array.size(arr) > 0
        Lvl v = array.shift(arr)
        line.delete(v.ln)
        label.delete(v.lb)

// The level marks where THIS chart traded when the reference index pivoted.
// Solid = its swing high, dashed = its swing low, so the tag stays one word.
f_draw(bool isHigh, color col, array<Lvl> arr) =>
    int   x0 = bar_index - pivLen
    float y  = isHigh ? high[pivLen] : low[pivLen]
    int   x1 = extendMode == "Fixed length" ? x0 + lineLen : bar_index
    line ln = line.new(x0, y, x1, y, color = col,
         style = isHigh ? line.style_solid : line.style_dashed, width = 1)
    label lab = label.new(x1, y, lblA, style = label.style_label_left,
         color = color.new(color.white, 100), textcolor = col, size = size.tiny)
    array.push(arr, Lvl.new(ln, lab, y, isHigh))
    f_trim(arr, maxLv)

f_maintain(array<Lvl> arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            Lvl  v      = array.get(arr, i)
            bool broken = removeHit and ((v.isHigh and close > v.y) or (not v.isHigh and close < v.y))
            if broken
                array.remove(arr, i)
                line.delete(v.ln)
                label.delete(v.lb)
            else if extendMode == "To current bar"
                line.set_x2(v.ln, bar_index)
                label.set_x(v.lb, bar_index)

if newDay and clearDaily
    f_clearAll(lvlA)

if showLvls
    f_maintain(lvlA)
    if not na(aPH)
        f_draw(true,  colA, lvlA)
    if not na(aPL)
        f_draw(false, colA, lvlA)

// ═══════════════════ Filters ═══════════════════
plot(showVWAP ? vwapV : na, "VWAP", color = color.new(color.orange, 0), linewidth = 1)
plot(showEMA  ? emaV  : na, "EMA",  color = color.new(color.purple, 0), linewidth = 1)

bool stretchOK_L = vwapMode == "Stretch" and (vwapV - close > stretchX * atr)
bool stretchOK_S = vwapMode == "Stretch" and (close - vwapV > stretchX * atr)
bool bullVwap = vwapMode == "Off" ? true : (close > vwapV or stretchOK_L)
bool bearVwap = vwapMode == "Off" ? true : (close < vwapV or stretchOK_S)
bool bullRsi  = not useRSI ? true : (rsiV > 50 or (stretchOK_L and rsiV > rsiV[1] and rsiV < 40))
bool bearRsi  = not useRSI ? true : (rsiV < 50 or (stretchOK_S and rsiV < rsiV[1] and rsiV > 60))
bool bullFilt = bullVwap and bullRsi and (not useEMA or close > emaV)
bool bearFilt = bearVwap and bearRsi and (not useEMA or close < emaV)

bool demTouch = zoneReady and low  <= demTop and low  >= demBot - atr
bool supTouch = zoneReady and high >= supBot and high <= supTop + atr
bool rejDem = demTouch and close > open and (rejMode == "Strict" ? close > demTop : close > demBot)
bool rejSup = supTouch and close < open and (rejMode == "Strict" ? close < supBot : close < supTop)

f_bounceLvl(array<Lvl> arr, bool wantHigh) =>
    float res = na
    for v in arr
        bool ok = v.isHigh == wantHigh and (wantHigh
                     ? (high >= v.y and close < v.y and close < open)
                     : (low  <= v.y and close > v.y and close > open))
        if ok
            res := na(res) ? v.y : (wantHigh ? math.min(res, v.y) : math.max(res, v.y))
    res

float lvlLowY  = na
float lvlHighY = na
if useLevels and showLvls
    lvlLowY  := f_bounceLvl(lvlA, false)
    lvlHighY := f_bounceLvl(lvlA, true)

// ═══════════════════ GTI engine (ported) ═══════════════════
// A spot index reports no traded volume, so every volume gate in GTI would
// silently pass or silently fail depending on the feed. Auto uses volume where
// it is real and degrades to price-only where it is not - the signals get looser,
// not wrong, and the diagnostics row says which mode you are in.
float volSma  = ta.sma(volume, 20)
bool  volReal = not na(volSma) and volSma > 0
bool  volOn   = useVol == "On" or (useVol == "Auto" and volReal)
f_vol(float mult) => not volOn ? true : volume > volSma * mult

float bodySz = math.abs(open - close)
float rng    = high - low
float upWick = high - math.max(open, close)
float dnWick = math.min(open, close) - low

// Squeeze: Bollinger inside Keltner. GTI compared both bands against a shared
// basis, which reduces to comparing the deviations - same test, half the code.
float bbDev = 2.0 * ta.stdev(close, 20)
float kcDev = 1.5 * ta.atr(20)
bool  squeeze = bbDev < kcDev
bgcolor(showSqz and squeeze ? color.new(color.purple, 92) : na, title = "Compression")

// Wave (5) exhaustion, both sides: a new extreme the oscillator does not confirm,
// stretched from VWAP, rejected by its own wick. GTI only had the bull case.
float priorHi  = ta.highest(high, w5Look)[1]
float priorLo  = ta.lowest(low,   w5Look)[1]
float priorRsiH = ta.highest(rsiV, w5Look)[1]
float priorRsiL = ta.lowest(rsiV,  w5Look)[1]
bool w5Top = high > priorHi and rsiV < priorRsiH and close > vwapV + atr * 0.8
     and upWick > bodySz and (close < open or close < high - rng * 0.4)
bool w5Bot = low < priorLo and rsiV > priorRsiL and close < vwapV - atr * 0.8
     and dnWick > bodySz and (close > open or close > low + rng * 0.4)
var int lastW5Top = -1000
var int lastW5Bot = -1000
if w5Top
    lastW5Top := bar_index
if w5Bot
    lastW5Bot := bar_index
bool w5LockL = useWave5 and (bar_index - lastW5Top) <= lockBars
bool w5LockS = useWave5 and (bar_index - lastW5Bot) <= lockBars

// Candle taxonomy - all shape, no volume, so it survives on a spot index.
bool bullInj = dnWick > bodySz * 1.8 and upWick < bodySz
bool bearInj = upWick > bodySz * 1.8 and dnWick < bodySz
bool belan   = bodySz < rng * 0.15
bool wideBar = rng > atr
bool absLow  = dnWick > bodySz * 1.3 and dnWick > rng * 0.35
bool absUp   = upWick > bodySz * 1.3 and upWick > rng * 0.35

bool instBuy  = f_vol(volMult) and (close > open or dnWick > bodySz * 0.8)
bool instSell = f_vol(volMult) and (close < open or upWick > bodySz * 0.8)
// ═══════════════════ Zone attack counter (GTI) ═══════════════════
// A zone is a wall until the third or fourth time it is hit. Black (selling)
// candles landing inside demand, or blue (buying) candles landing inside supply,
// are counted; the count is wiped the moment price clears the opposite zone,
// which is GTI's "data neutralised". At the threshold the zone has proved it
// holds and the break of the last attack candle is the trade - away from the
// zone, not through it. The fired latch is keyed to the count, so the fourth
// attack can trade again after the third one stopped out.
var int   atkDem = 0
var float atkDemHi = na
var float atkDemLo = na
var int   atkDemFired = -1
var int   atkSup = 0
var float atkSupHi = na
var float atkSupLo = na
var int   atkSupFired = -1

if newDay
    atkDem := 0
    atkSup := 0
    atkDemHi := na
    atkDemLo := na
    atkSupHi := na
    atkSupLo := na
    atkDemFired := -1
    atkSupFired := -1

bool hitDem = false
bool hitSup = false
if zoneReady and inMkt
    // Two ways a count dies: price reaches the opposite zone (GTI's "data
    // neutralised") or closes through the zone itself - a wall that broke held
    // nothing, so its attacks stop being evidence. Found in the 11-Sep-2026
    // review: without the second test the count survived a break and a later
    // bounce could fire off a zone that had already failed. No-op in Auto zone
    // mode, whose edges trail price and cannot be closed through.
    if close > supBot or close < demBot
        atkDem := 0
        atkDemHi := na
        atkDemLo := na
        atkDemFired := -1
    else if instSell and low <= demTop
        atkDem += 1
        atkDemHi := high
        atkDemLo := low
        hitDem := true
    if close < demTop or close > supTop
        atkSup := 0
        atkSupHi := na
        atkSupLo := na
        atkSupFired := -1
    else if instBuy and high >= supBot
        atkSup += 1
        atkSupHi := high
        atkSupLo := low
        hitSup := true

bool atkLong  = useAttack and atkDem >= attackMin and not na(atkDemHi) and close > atkDemHi and atkDemFired != atkDem
bool atkShort = useAttack and atkSup >= attackMin and not na(atkSupLo) and close < atkSupLo and atkSupFired != atkSup
if atkLong
    atkDemFired := atkDem
if atkShort
    atkSupFired := atkSup

if showAttack and hitDem
    label.new(bar_index, low, str.tostring(atkDem), style = label.style_label_up,
         color = color.new(color.maroon, 20), textcolor = color.white, size = size.tiny)
if showAttack and hitSup
    label.new(bar_index, high, str.tostring(atkSup), style = label.style_label_down,
         color = color.new(color.blue, 20), textcolor = color.white, size = size.tiny)

// Whale colours need real volume to mean anything; the grey absorption tint
// is pure shape, so it stays on either way.
color barCol = not showBars ? na
     : volOn and instBuy and not instSell ? color.blue
     : volOn and instSell and not instBuy ? color.black
     : rng >= atr * atrExpMult and f_vol(1.0) ? color.yellow
     : absLow or absUp or belan ? color.rgb(130, 130, 130) : na
barcolor(barCol)

// Shark (3) / whale (4) flag runs
bool bullBar = close > open and bodySz > rng * 0.5
bool bearBar = close < open and bodySz > rng * 0.5
bool isoBull = close > ta.highest(high, isoBars)[3]
bool isoBear = close < ta.lowest(low,  isoBars)[3]
bool bull3 = bullBar and bullBar[1] and bullBar[2] and isoBull
bool bear3 = bearBar and bearBar[1] and bearBar[2] and isoBear
bool bull4 = bull3[1] and bullBar
bool bear4 = bear3[1] and bearBar

// Expansion bar - the one bar every reversion source is blind to: range
// expansion with volume, closing near its extreme, in the bias direction,
// within a few bars of a squeeze. 11-Sep-2026 11:12 came out of "1 Compression"
// as a 3-bar run (a trap by the flag rule; the 4-flag is one bar later) and
// touched no zone, level or attack candle. This buys strength where everything
// else here buys weakness; the bias and squeeze tests are what keep it from
// chasing every big bar. Stop is the bar's own extreme, so the risk stage
// still has the final word on a bar that ran too far.
int   sinceSqz = ta.barssince(squeeze)
bool  expBar   = rng >= atr * atrExpMult and f_vol(1.0) and sinceSqz <= 3
bool  expandL  = useExpand and expBar and close > open and close >= high - rng * 0.25 and dayBias ==  1
bool  expandS  = useExpand and expBar and close < open and close <= low  + rng * 0.25 and dayBias == -1

// Absorption at the edge of the day's structure. Uses SD-X's own zone so it
// works in every zone mode, not just the gap-adaptive one.
bool atBase    = (zoneReady and low  <= demTop) or low  <= ta.lowest(low,  swingLen)[1] + atr * 0.35
bool atCeiling = (zoneReady and high >= supBot) or high >= ta.highest(high, swingLen)[1] - atr * 0.35
bool absorbL = atBase    and absLow and f_vol(volMult) and close >= vwapV
bool absorbS = atCeiling and absUp  and f_vol(volMult) and close <= vwapV

// Climax: without real volume, an outsized range is the honest stand-in.
bool climaxVol = volOn ? f_vol(extVolMult) : rng >= atr * atrExpMult
bool climaxUp = climaxVol and close > open and atCeiling
bool climaxDn = climaxVol and close < open and atBase

var array<Lvl> shelves = array.new<Lvl>()
f_shelf(float y, color col, string tag, bool dashed) =>
    line ln = line.new(bar_index, y, bar_index + shelfBars, y, color = col, width = 2,
         style = dashed ? line.style_dashed : line.style_solid)
    label lb = label.new(bar_index + shelfBars, y, tag, style = label.style_label_left,
         color = color.new(color.white, 100), textcolor = col, size = size.tiny)
    array.push(shelves, Lvl.new(ln, lb, y, true))
    f_trim(shelves, maxShelf * 2)

if showShelf and climaxDn
    f_shelf(low, color.maroon, str.tostring(dayofmonth(time, "Asia/Kolkata")), false)
    f_shelf(low + rng * 0.5, color.teal, "", true)
if showShelf and climaxUp
    f_shelf(high, color.orange, str.tostring(dayofmonth(time, "Asia/Kolkata")), false)
    f_shelf(high - rng * 0.5, color.orange, "", true)

// CAMDC phase
var string phase    = "2 Accumulation"
var color  phaseCol = color.teal
var int    lastPhase = 0
if squeeze
    phase := "1 Compression"
    phaseCol := color.purple
    lastPhase := bar_index
else if bar_index - lastPhase >= 3
    if bull3 or bear3 or (zoneReady and ((high >= supBot and close < supBot) or (low <= demTop and close > demTop)))
        phase := "3 Manipulation"
        phaseCol := color.red
        lastPhase := bar_index
    else if bull4 or bear4 or rng >= atr * atrExpMult
        phase := "4 Distribution"
        phaseCol := color.blue
        lastPhase := bar_index
    else if (close > vwapV and close < open) or (close < vwapV and close > open)
        phase := "5 Correction"
        phaseCol := color.orange
        lastPhase := bar_index
    else
        phase := "2 Accumulation"
        phaseCol := color.teal
        lastPhase := bar_index

// Context markers
plotshape(showCandle and bullInj and wideBar,  "Strong bull", shape.triangleup,   location.belowbar, color = color.lime,    size = size.small)
plotshape(showCandle and bearInj and wideBar,  "Strong bear", shape.triangledown, location.abovebar, color = color.fuchsia, size = size.small)
plotshape(showCandle and belan and wideBar,    "Strong belan", shape.diamond,     location.abovebar, color = color.orange,  size = size.tiny)
plotshape(showCandle and bullInj and not wideBar, "Weak bull",  shape.circle,     location.belowbar, color = color.lime,    size = size.tiny)
plotshape(showCandle and bearInj and not wideBar, "Weak bear",  shape.circle,     location.abovebar, color = color.fuchsia, size = size.tiny)
plotshape(showCandle and belan and not wideBar,   "Weak belan", shape.xcross,     location.abovebar, color = color.orange,  size = size.tiny)
plotshape(w5Top, "Wave 5 top", shape.labeldown, location.abovebar, color = color.maroon, text = "W5", textcolor = color.white, size = size.tiny)
plotshape(w5Bot, "Wave 5 bottom", shape.labelup, location.belowbar, color = color.green,  text = "W5", textcolor = color.white, size = size.tiny)
plotshape(showFlags and bull3 and not bull4, "Shark trap up",   shape.labeldown, location.abovebar, color = color.yellow, text = "TRAP", textcolor = color.black, size = size.tiny)
plotshape(showFlags and bear3 and not bear4, "Shark trap down", shape.labelup,   location.belowbar, color = color.yellow, text = "TRAP", textcolor = color.black, size = size.tiny)
plotshape(showFlags and bull4, "Whale 4-flag long",  shape.labelup,   location.belowbar, color = color.blue,  text = "4F", textcolor = color.white, size = size.tiny)
plotshape(showFlags and bear4, "Whale 4-flag short", shape.labeldown, location.abovebar, color = color.black, text = "4F", textcolor = color.white, size = size.tiny)
plotshape(climaxDn, "Bear climax", shape.square, location.abovebar, color = color.maroon, size = size.small)
plotshape(climaxUp, "Bull climax", shape.square, location.belowbar, color = color.orange, size = size.small)

// ═══════════════════ Trades ═══════════════════
type Trade
    bool  isLong
    float entry
    float sl
    float tp
    int   strike
    line  enLn
    line  slLn
    line  tpLn
    label slLb
    label tpLb

// Several signals can be live at once: you may skip one you do not like and
// still want the next zone touch marked. Closed trades leave the array.
var array<Trade> openT = array.new<Trade>()
var int   lastSigBar  = -1000
var int   tradesToday = 0
var int   winsToday   = 0
var int   lossToday   = 0
var float ptsToday    = 0.0

var int cRawL = 0, var int cRawS = 0
var int cFiltL = 0, var int cFiltS = 0
var int cRiskL = 0, var int cRiskS = 0
var int cRoomL = 0, var int cRoomS = 0
var int cRegL = 0,  var int cRegS = 0
var int cGateL = 0, var int cGateS = 0
var int cSigL = 0,  var int cSigS = 0
var int cDemT = 0,  var int cSupT = 0

if newDay
    tradesToday := 0
    winsToday   := 0
    lossToday   := 0
    ptsToday    := 0.0
    cRawL := 0
    cRawS := 0
    cFiltL := 0
    cFiltS := 0
    cRiskL := 0
    cRiskS := 0
    cRoomL := 0
    cRoomS := 0
    cRegL := 0
    cRegS := 0
    cGateL := 0
    cGateS := 0
    cSigL := 0
    cSigS := 0
    cDemT := 0
    cSupT := 0

// Reverse walk so array.remove never shifts an index still to be visited.
if array.size(openT) > 0
    for i = array.size(openT) - 1 to 0
        Trade tr = array.get(openT, i)
        line.set_x2(tr.enLn, bar_index)
        line.set_x2(tr.slLn, bar_index)
        line.set_x2(tr.tpLn, bar_index)
        label.set_x(tr.slLb, bar_index)
        label.set_x(tr.tpLb, bar_index)
        bool hitSL = tr.isLong ? low  <= tr.sl : high >= tr.sl
        bool hitTP = tr.isLong ? high >= tr.tp : low  <= tr.tp
        if hitSL or hitTP or forceExit
            // A bar spanning both is unknowable intrabar: take the stop, never the gift.
            float ex  = hitSL ? tr.sl : hitTP ? tr.tp : close
            float pts = tr.isLong ? ex - tr.entry : tr.entry - ex
            ptsToday  += pts
            winsToday += pts >= 0 ? 1 : 0
            lossToday += pts <  0 ? 1 : 0
            array.remove(openT, i)
            // Strike on every exit tag: with several live you need to know which.
            label.new(bar_index, ex,
                 (hitSL ? "STOP" : hitTP ? "TARGET" : "SQ-OFF") + "  " + str.tostring(tr.strike) + (tr.isLong ? "CE" : "PE"),
                 style = hitTP and not hitSL ? label.style_label_down : label.style_label_up,
                 color = hitSL ? color.new(color.red, 0) : hitTP ? color.new(color.black, 0) : color.new(color.gray, 0),
                 textcolor = color.white, size = size.tiny)

bool tradeOpen = array.size(openT) > 0
bool entryOK   = inEntry and (not isExpiry or inExpE)
// No `not tradeOpen` here: a live trade no longer mutes the next setup. Total
// exposure is still bounded by maxPerDay; cooldown still stops machine-gunning
// the same touch bar after bar.
bool canSignal = entryOK and inMkt and not forceExit
                 and tradesToday < maxPerDay and (bar_index - lastSigBar) > cooldown

// Six entry sources now, each with its own stop anchor. Order is priority:
// the tightest structural stop wins when more than one fires on a bar.
bool sigZoneL = useZone and rejDem
bool sigZoneS = useZone and rejSup
bool sigLvlL  = not na(lvlLowY)
bool sigLvlS  = not na(lvlHighY)
bool sigFlagL = use4Flag and bull4
bool sigFlagS = use4Flag and bear4
bool sigAbsL  = useAbsorb and absorbL
bool sigAbsS  = useAbsorb and absorbS
bool sigAtkL  = atkLong
bool sigAtkS  = atkShort
bool sigExpL  = expandL
bool sigExpS  = expandS
bool rawLong  = sigZoneL or sigLvlL or sigFlagL or sigAbsL or sigAtkL or sigExpL
bool rawShort = sigZoneS or sigLvlS or sigFlagS or sigAbsS or sigAtkS or sigExpS

float flagLo = ta.lowest(low, 4)                  // hoisted: ta.* must run every bar
float flagHi = ta.highest(high, 4)
float lBase = sigZoneL ? demBot : sigLvlL ? lvlLowY
     : sigFlagL ? flagLo : sigAbsL ? low : sigAtkL ? atkDemLo : sigExpL ? low : na
float sBase = sigZoneS ? supTop : sigLvlS ? lvlHighY
     : sigFlagS ? flagHi : sigAbsS ? high : sigAtkS ? atkSupHi : sigExpS ? high : na
string lSrc = sigZoneL ? "zone" : sigLvlL ? "level" : sigFlagL ? "4-flag" : sigAbsL ? "absorb" : sigAtkL ? "attack" : "expand"
string sSrc = sigZoneS ? "zone" : sigLvlS ? "level" : sigFlagS ? "4-flag" : sigAbsS ? "absorb" : sigAtkS ? "attack" : "expand"
float lSL = na(lBase) ? na : math.min(lBase, low)  - atr * slBuf
float sSL = na(sBase) ? na : math.max(sBase, high) + atr * slBuf
lSL := na(lSL) ? na : math.min(lSL, close - minRisk)
sSL := na(sSL) ? na : math.max(sSL, close + minRisk)
float lRisk = na(lSL) ? na : close - lSL
float sRisk = na(sSL) ? na : sSL - close

bool riskOKL = not na(lRisk) and lRisk <= maxRisk
bool riskOKS = not na(sRisk) and sRisk <= maxRisk

// Structural target: aim at the next gap tier overhead (long) or underfoot
// (short) instead of a fixed multiple. Needs gap-adaptive zones to have tiers
// at all, so it falls back to fixed R:R on every other zone source.
bool  structTP = tpMode == "Structure (gap tiers)" and gapMode
bool  ladderTP = tpMode == "Opening-range ladder" and orbReady
float lTgt = structTP ? (close < supMainBot ? supMainBot
     : close < supTgtBot ? supTgtBot : supTgtTop) : ladderTP ? f_rungUp(close) : na
float sTgt = structTP ? (close > demMainTop ? demMainTop
     : close > demTgtTop ? demTgtTop : demTgtBot) : ladderTP ? f_rungDn(close) : na
// Too little room to the next wall is a reason not to take the trade, not a
// reason to aim through it. Fixed R:R has a wall too - the opposing zone - so
// the same minRR test runs in every mode, tier or zone edge. 09-Sep-2026 took
// a 4-flag short 0.3 ATR above demand because roomOK was hardcoded true here.
// The expansion bar never takes a structural target: it has just broken the
// structure, and the ladder rung it would aim at can sit a dozen points away
// (11-Sep 11:12: 1:3 rung 13 points above entry). It runs on its own R:R,
// lower than the reversion sources' - after a 45-point bar on a VIX-12 day,
// 2R was 85 points more on a session that had ranged 120 all morning.
bool  lTgtOK = not na(lTgt) and not sigExpL
bool  sTgtOK = not na(sTgt) and not sigExpS
// A zone price has already closed through is the breakout, not a wall ahead,
// so it stops counting as room. Inside it or short of it, it still counts -
// the 09-Sep short above demand stays blocked. The expansion bar is the one
// exception: the zone it closes into IS what it is breaking (11-Sep 11:12
// closed 5 points inside the band), and the next structure is unknown, so
// it gets fixed R:R with no wall test.
float lWall = lTgtOK ? lTgt : (close > supTop or sigExpL) ? na : supBot
float sWall = sTgtOK ? sTgt : (close < demBot or sigExpS) ? na : demTop
float lRR  = na(lWall) or na(lRisk) or lRisk <= 0 ? na : (lWall - close) / lRisk
float sRR  = na(sWall) or na(sRisk) or sRisk <= 0 ? na : (close - sWall) / sRisk
// No zone / no tier yet -> na -> pass, same as before.
bool roomOKL = na(lRR) or lRR >= minRR
bool roomOKS = na(sRR) or sRR >= minRR
float lTP = lTgtOK ? lTgt : close + lRisk * (sigExpL ? expandRR : rr)
float sTP = sTgtOK ? sTgt : close - sRisk * (sigExpS ? expandRR : rr)

// Exhaustion lockout and compression are regime vetoes: the setup was real,
// the tape is just the wrong shape to take it.
// Day bias, structural compression and the 1:N exhaustion all veto rather than
// trigger, so they join the regime stage and are counted in the same DIAG row.
bool biasOKL = not biasVeto or dayBias ==  1
bool biasOKS = not biasVeto or dayBias == -1
bool compOK  = not reqCompress or structCompressed
bool regimeOKL = not w5LockL and not (blockSqz and squeeze) and biasOKL and compOK and not (ladderStop and ladderHitU)
bool regimeOKS = not w5LockS and not (blockSqz and squeeze) and biasOKS and compOK and not (ladderStop and ladderHitD)

bool longSig  = canSignal and bullFilt and rawLong  and riskOKL and roomOKL and regimeOKL
bool shortSig = canSignal and bearFilt and rawShort and riskOKS and roomOKS and regimeOKS

bool blkFiltL = rawLong  and not bullFilt
bool blkFiltS = rawShort and not bearFilt
bool blkRiskL = rawLong  and bullFilt and not riskOKL
bool blkRiskS = rawShort and bearFilt and not riskOKS
bool blkRoomL = rawLong  and bullFilt and riskOKL and not roomOKL
bool blkRoomS = rawShort and bearFilt and riskOKS and not roomOKS
bool blkRegL  = rawLong  and bullFilt and riskOKL and roomOKL and not regimeOKL
bool blkRegS  = rawShort and bearFilt and riskOKS and roomOKS and not regimeOKS
bool blkGateL = rawLong  and bullFilt and riskOKL and roomOKL and regimeOKL and not canSignal
bool blkGateS = rawShort and bearFilt and riskOKS and roomOKS and regimeOKS and not canSignal

// ═══════════════════ Shadow: filter-blocked, bias agrees ═══════════════════
// Measurement only - nothing here plots, gates or counts against the daily cap.
// A setup the VWAP/RSI/EMA filter refused while the opening break agreed with
// it, and which every later stage would have passed, is paper-traded with the
// real stop and target. The DIAG rows then say whether the "buy-on-dip under
// VWAP" trade the day bias implies is worth an exception. 11-Sep-2026: six such
// longs were refused on a day that ran 100 points. One day is not evidence;
// this row is how the evidence gets collected.
type Shadow
    bool  isLong
    float entry
    float sl
    float tp
var array<Shadow> shadowT = array.new<Shadow>()
var int   lastShBar = -1000
var int   cShL = 0, var int cShS = 0
var int   shWin = 0, var int shLoss = 0
var float shPts = 0.0
if newDay
    cShL := 0
    cShS := 0
    shWin := 0
    shLoss := 0
    shPts := 0.0

bool shadowL = blkFiltL and dayBias ==  1 and riskOKL and roomOKL and regimeOKL and canSignal
     and (bar_index - lastShBar) > cooldown
bool shadowS = blkFiltS and dayBias == -1 and riskOKS and roomOKS and regimeOKS and canSignal
     and (bar_index - lastShBar) > cooldown

// Same exit rules as a real trade: stop wins a bar that spans both.
if array.size(shadowT) > 0
    for i = array.size(shadowT) - 1 to 0
        Shadow sh = array.get(shadowT, i)
        bool shSL = sh.isLong ? low  <= sh.sl : high >= sh.sl
        bool shTP = sh.isLong ? high >= sh.tp : low  <= sh.tp
        if shSL or shTP or forceExit
            float ex  = shSL ? sh.sl : shTP ? sh.tp : close
            float pts = sh.isLong ? ex - sh.entry : sh.entry - ex
            shPts  += pts
            shWin  += pts >= 0 ? 1 : 0
            shLoss += pts <  0 ? 1 : 0
            array.remove(shadowT, i)
if inMkt and (shadowL or shadowS)
    array.push(shadowT, Shadow.new(shadowL, close, shadowL ? lSL : sSL, shadowL ? lTP : sTP))
    lastShBar := bar_index
    cShL += shadowL ? 1 : 0
    cShS += shadowS ? 1 : 0

if inMkt
    cDemT  += demTouch ? 1 : 0
    cSupT  += supTouch ? 1 : 0
    cRawL  += rawLong  ? 1 : 0
    cRawS  += rawShort ? 1 : 0
    cFiltL += blkFiltL ? 1 : 0
    cFiltS += blkFiltS ? 1 : 0
    cRiskL += blkRiskL ? 1 : 0
    cRiskS += blkRiskS ? 1 : 0
    cRoomL += blkRoomL ? 1 : 0
    cRoomS += blkRoomS ? 1 : 0
    cRegL  += blkRegL  ? 1 : 0
    cRegS  += blkRegS  ? 1 : 0
    cGateL += blkGateL ? 1 : 0
    cGateS += blkGateS ? 1 : 0
    cSigL  += longSig  ? 1 : 0
    cSigS  += shortSig ? 1 : 0

plotshape(longSig,  "Buy CE", shape.circle, location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(shortSig, "Buy PE", shape.circle, location.abovebar, color = color.new(color.red,   0), size = size.small)
plotshape(showNM and rawLong  and not longSig,  "Blocked long",  shape.xcross, location.belowbar,
     color = color.new(color.gray, 40), size = size.tiny)
plotshape(showNM and rawShort and not shortSig, "Blocked short", shape.xcross, location.abovebar,
     color = color.new(color.gray, 40), size = size.tiny)

f_open(bool isLong, float sl, float risk, float tp, int strike, string src) =>
    float entry = close
    float pSL   = risk * deltaATM                     // premium move to the stop
    float pTP   = math.abs(tp - entry) * deltaATM     // premium move to the target
    float gotRR = math.abs(tp - entry) / risk
    string side = isLong ? "CE" : "PE"
    line en = line.new(bar_index, entry, bar_index, entry, color = color.new(color.gray, 30), style = line.style_dotted, width = 1)
    line sn = line.new(bar_index, sl, bar_index, sl, color = color.new(color.red, 0), width = 2)
    line tn = line.new(bar_index, tp, bar_index, tp, color = color.new(color.black, 0), width = 2)
    label sb = label.new(bar_index, sl, "SL " + str.tostring(sl, format.mintick) + "  (prem −" + str.tostring(pSL, "#.#") + ")",
         style = label.style_label_left, color = color.new(color.red, 0), textcolor = color.white, size = size.tiny)
    label tb = label.new(bar_index, tp, "TGT " + str.tostring(tp, format.mintick) + "  " + str.tostring(gotRR, "#.#") + "R  (prem +" + str.tostring(pTP, "#.#") + ")",
         style = label.style_label_left, color = color.new(color.black, 0), textcolor = color.white, size = size.tiny)
    label.new(bar_index, isLong ? low : high, "BUY " + str.tostring(strike) + " " + side + "  " + src,
         style = isLong ? label.style_label_up : label.style_label_down,
         color = isLong ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.small)
    Trade.new(isLong = isLong, entry = entry, sl = sl, tp = tp, strike = strike,
         enLn = en, slLn = sn, tpLn = tn, slLb = sb, tpLb = tb)

if longSig
    array.push(openT, f_open(true, lSL, lRisk, lTP, atmStrike, lSrc))
    lastSigBar  := bar_index
    tradesToday += 1
if shortSig
    array.push(openT, f_open(false, sSL, sRisk, sTP, atmStrike, sSrc))
    lastSigBar  := bar_index
    tradesToday += 1

// ═══════════════════ Tables ═══════════════════
float estPrem = ptsToday * deltaATM
float estRs   = estPrem * lotSize * lots

var table st = table.new(position.top_right, 2, 11, border_width = 1)
if showStats and barstate.islast
    table.cell(st, 0, 0, "Today", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.tiny)
    table.cell(st, 1, 0, str.tostring(tradesToday) + "/" + str.tostring(maxPerDay),
         text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.tiny)
    table.cell(st, 0, 1, "Won",  text_size = size.tiny)
    table.cell(st, 1, 1, str.tostring(winsToday), text_color = color.green, text_size = size.tiny)
    table.cell(st, 0, 2, "Lost", text_size = size.tiny)
    table.cell(st, 1, 2, str.tostring(lossToday), text_color = color.red, text_size = size.tiny)
    table.cell(st, 0, 3, "Index pts", text_size = size.tiny)
    table.cell(st, 1, 3, str.tostring(ptsToday, "#.##"), text_color = ptsToday >= 0 ? color.green : color.red, text_size = size.tiny)
    table.cell(st, 0, 4, "₹ est", text_size = size.tiny)
    table.cell(st, 1, 4, str.tostring(estRs, "#,###"), text_color = estRs >= 0 ? color.green : color.red, text_size = size.tiny)
    table.cell(st, 0, 5, "ATM", text_size = size.tiny)
    table.cell(st, 1, 5, str.tostring(atmStrike) + (isExpiry ? "  EXPIRY" : ""),
         text_color = isExpiry ? color.red : color.gray, text_size = size.tiny)
    if showVix
        table.cell(st, 0, 6, "VIX", text_size = size.tiny)
        table.cell(st, 1, 6, na(vix) ? "n/a" : str.tostring(vix, "#.##"), text_color = vixCol, text_size = size.tiny)
        table.cell(st, 0, 7, "Regime", text_size = size.tiny)
        table.cell(st, 1, 7, regime + "  ->  " + strikeAdv, text_color = vixCol, text_size = size.tiny)
    if showPhase
        table.cell(st, 0, 8, "Phase", text_size = size.tiny)
        table.cell(st, 1, 8, phase + (volOn ? "" : "  (no vol)"), text_color = phaseCol, text_size = size.tiny)
    table.cell(st, 0, 9, "Battlefield", text_size = size.tiny)
    table.cell(st, 1, 9, na(battle) ? "n/a" : str.tostring(battle, "#.#") + (structCompressed ? "  COMPRESSED" : "  open"),
         text_color = structCompressed ? color.purple : color.gray, text_size = size.tiny)
    table.cell(st, 0, 10, "Day bias", text_size = size.tiny)
    table.cell(st, 1, 10, not orbReady ? "waiting for opening candle"
         : (dayBias == 1 ? "LONG  buy-on-dip" : dayBias == -1 ? "SHORT  sell-on-rise" : "unbroken")
           + "  [" + str.tostring(orbLo, "#") + "-" + str.tostring(orbHi, "#") + "]" + (orbFake ? " c2" : ""),
         text_color = dayBias == 1 ? color.green : dayBias == -1 ? color.red : color.gray, text_size = size.tiny)

float demDistATR = zoneReady ? math.abs(close - demTop) / atr : na
float supDistATR = zoneReady ? math.abs(supBot - close) / atr : na

var table dg = table.new(position.bottom_right, 3, 13, border_width = 1)
if showDiag and barstate.islast
    table.cell(dg, 0, 0, "DIAG today", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.tiny)
    table.cell(dg, 1, 0, "L", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.tiny)
    table.cell(dg, 2, 0, "S", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.tiny)
    table.cell(dg, 0, 1, "Zone touched", text_size = size.tiny)
    table.cell(dg, 1, 1, str.tostring(cDemT), text_size = size.tiny)
    table.cell(dg, 2, 1, str.tostring(cSupT), text_size = size.tiny)
    table.cell(dg, 0, 2, "Zone dist (ATR)", text_size = size.tiny)
    table.cell(dg, 1, 2, str.tostring(demDistATR, "#.#"), text_color = demDistATR > maxZoneATR ? color.red : color.gray, text_size = size.tiny)
    table.cell(dg, 2, 2, str.tostring(supDistATR, "#.#"), text_color = supDistATR > maxZoneATR ? color.red : color.gray, text_size = size.tiny)
    table.cell(dg, 0, 3, "Setups found", text_size = size.tiny)
    table.cell(dg, 1, 3, str.tostring(cRawL), text_size = size.tiny)
    table.cell(dg, 2, 3, str.tostring(cRawS), text_size = size.tiny)
    table.cell(dg, 0, 4, "Blocked: filter", text_size = size.tiny)
    table.cell(dg, 1, 4, str.tostring(cFiltL), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 2, 4, str.tostring(cFiltS), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 0, 5, "Blocked: risk", text_size = size.tiny)
    table.cell(dg, 1, 5, str.tostring(cRiskL), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 2, 5, str.tostring(cRiskS), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 0, 6, "Blocked: no room", text_size = size.tiny)
    table.cell(dg, 1, 6, str.tostring(cRoomL), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 2, 6, str.tostring(cRoomS), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 0, 7, "Blocked: regime", text_size = size.tiny)
    table.cell(dg, 1, 7, str.tostring(cRegL), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 2, 7, str.tostring(cRegS), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 0, 8, "Blocked: session/limit", text_size = size.tiny)
    table.cell(dg, 1, 8, str.tostring(cGateL), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 2, 8, str.tostring(cGateS), text_color = color.orange, text_size = size.tiny)
    table.cell(dg, 0, 9, "SIGNALS", text_size = size.tiny)
    table.cell(dg, 1, 9, str.tostring(cSigL), text_color = color.green, text_size = size.tiny)
    table.cell(dg, 2, 9, str.tostring(cSigS), text_color = color.red, text_size = size.tiny)
    table.cell(dg, 0, 10, "Zone / VWAP / RSI", text_size = size.tiny)
    table.cell(dg, 1, 10, str.tostring(demBot, "#") + "-" + str.tostring(demTop, "#"), text_size = size.tiny)
    table.cell(dg, 2, 10, str.tostring(vwapV, "#") + " / " + str.tostring(rsiV, "#"), text_size = size.tiny)
    table.cell(dg, 0, 11, "Shadow: bias-only", text_size = size.tiny)
    table.cell(dg, 1, 11, str.tostring(cShL), text_color = color.gray, text_size = size.tiny)
    table.cell(dg, 2, 11, str.tostring(cShS), text_color = color.gray, text_size = size.tiny)
    table.cell(dg, 0, 12, "Shadow W / L / pts", text_size = size.tiny)
    table.cell(dg, 1, 12, str.tostring(shWin) + " / " + str.tostring(shLoss), text_color = color.gray, text_size = size.tiny)
    table.cell(dg, 2, 12, str.tostring(shPts, "#.#"), text_color = shPts >= 0 ? color.green : color.red, text_size = size.tiny)

// ═══════════════════ Alerts ═══════════════════
alertcondition(longSig,  "SD-X Buy CE", "BUY ATM CE — index {{close}}")
alertcondition(shortSig, "SD-X Buy PE", "BUY ATM PE — index {{close}}")
alertcondition(forceExit and tradeOpen, "SD-X Square off", "Square off open option position")
alertcondition(w5Top, "SD-X Wave 5 top", "Wave (5) exhaustion at the highs - stop chasing longs")
alertcondition(w5Bot, "SD-X Wave 5 bottom", "Wave (5) exhaustion at the lows - stop chasing shorts")
alertcondition(bull4, "SD-X Whale 4-flag long", "Whale 4-flag expansion up")
alertcondition(bear4, "SD-X Whale 4-flag short", "Whale 4-flag breakdown")
alertcondition(absorbL, "SD-X Absorption at base", "Absorption wick at the base, holding VWAP")
alertcondition(absorbS, "SD-X Absorption at ceiling", "Absorption wick at the ceiling, capped by VWAP")
alertcondition(orbReady and dayBias != 0 and dayBias[1] == 0, "SD-X Opening break", "Opening candle broken — day bias is set")
alertcondition(atkLong,  "SD-X Zone attack long",  "Demand held its Nth attack — break of the last black candle")
alertcondition(atkShort, "SD-X Zone attack short", "Supply held its Nth attack — break of the last blue candle")
alertcondition(expandL, "SD-X Expansion long",  "Expansion bar out of a squeeze, with the day bias, closing near its high")
alertcondition(expandS, "SD-X Expansion short", "Expansion bar out of a squeeze, with the day bias, closing near its low")
alertcondition(ladderHitU and not ladderHitU[1], "SD-X Ladder 1:N up", "Opening-range ladder target reached to the upside")
alertcondition(ladderHitD and not ladderHitD[1], "SD-X Ladder 1:N down", "Opening-range ladder target reached to the downside")
